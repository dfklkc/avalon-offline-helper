.identity-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  padding-top: 42rpx;
}

.identity-header {
  text-align: center;
}

.identity-title {
  margin-top: 14rpx;
  color: #fff8e9;
  font-family: Georgia, "Songti SC", serif;
  font-size: 46rpx;
  font-weight: 700;
}

.identity-warning {
  display: inline-flex;
  min-height: 48rpx;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(109, 125, 144, 0.2);
  border-radius: 999rpx;
  background: rgba(15, 20, 29, 0.52);
  color: #929aa7;
  font-size: 21rpx;
}

.privacy-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #70ad88;
  box-shadow: 0 0 12rpx rgba(112, 173, 136, 0.46);
}

.secret-card {
  display: flex;
  min-height: 760rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 38rpx;
  padding: 52rpx 40rpx;
  border-color: rgba(218, 184, 116, 0.34);
  overflow: hidden;
  position: relative;
  text-align: center;
  user-select: none;
  background:
    radial-gradient(circle at 50% 42%, rgba(183, 139, 65, 0.09), transparent 38%),
    linear-gradient(155deg, rgba(28, 35, 48, 0.98), rgba(17, 22, 31, 0.98));
}

.secret-card::before {
  width: 440rpx;
  height: 440rpx;
  border: 2rpx solid rgba(215, 180, 106, 0.11);
  border-radius: 50%;
  content: '';
  left: 50%;
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
}

.secret-card::after {
  width: 180rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(218, 182, 109, 0.4), transparent);
  content: '';
  left: 50%;
  position: absolute;
  top: 28rpx;
  transform: translateX(-50%);
}

.secret-card.is-revealed {
  justify-content: flex-start;
  background:
    radial-gradient(circle at 50% 4%, rgba(197, 158, 84, 0.1), transparent 24%),
    linear-gradient(155deg, #202a37 0%, #151b25 54%, #10141c 100%);
}

.secret-card.camp-good {
  border-color: rgba(104, 167, 212, 0.58);
  box-shadow: 0 20rpx 64rpx rgba(37, 102, 151, 0.18);
}

.secret-card.camp-evil {
  border-color: rgba(205, 82, 75, 0.58);
  box-shadow: 0 20rpx 64rpx rgba(145, 42, 42, 0.2);
}

.seal {
  display: flex;
  width: 180rpx;
  height: 180rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(221, 187, 117, 0.62);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(200, 155, 74, 0.13), rgba(13, 18, 26, 0.18));
  box-shadow: 0 0 0 12rpx rgba(211, 170, 88, 0.035), inset 0 0 34rpx rgba(219, 179, 98, 0.045);
  color: #e0bd75;
  font-size: 90rpx;
  position: relative;
  z-index: 1;
}

.small-seal {
  width: 110rpx;
  height: 110rpx;
  font-size: 54rpx;
}

.hold-title,
.loading-title {
  margin-top: 44rpx;
  color: #f7ecd8;
  font-size: 35rpx;
  font-weight: 700;
  position: relative;
  z-index: 1;
}

.hold-hint {
  margin-top: 14rpx;
  color: #818997;
  position: relative;
  z-index: 1;
}

.hold-line {
  width: 230rpx;
  height: 5rpx;
  margin-top: 42rpx;
  border-radius: 999rpx;
  background: #313846;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.hold-line-fill {
  width: 45%;
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #8b692f, #dbb66d);
  box-shadow: 0 0 12rpx rgba(208, 168, 89, 0.3);
}

.camp-label {
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(115, 174, 209, 0.24);
  border-radius: 999rpx;
  background: rgba(63, 116, 151, 0.1);
  color: #aebfd0;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 7rpx;
  position: relative;
  z-index: 1;
}

.camp-evil .camp-label {
  border-color: rgba(205, 91, 84, 0.24);
  background: rgba(137, 47, 48, 0.12);
  color: #e6948f;
}

.role-name {
  margin-top: 24rpx;
  color: #fff8e9;
  font-family: Georgia, "Songti SC", serif;
  font-size: 74rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  position: relative;
  z-index: 1;
}

.role-description {
  max-width: 520rpx;
  margin-top: 24rpx;
  color: #aab1bc;
  font-size: 26rpx;
  line-height: 1.65;
  position: relative;
  z-index: 1;
}

.role-guide {
  width: 100%;
  margin-top: 30rpx;
  padding: 4rpx 26rpx;
  border: 1rpx solid rgba(125, 142, 163, 0.23);
  border-radius: 20rpx;
  background: linear-gradient(145deg, rgba(11, 15, 22, 0.48), rgba(18, 24, 33, 0.34));
  position: relative;
  text-align: left;
  z-index: 1;
}

.guide-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(125, 142, 163, 0.16);
}

.guide-row:last-child {
  border-bottom: 0;
}

.guide-label,
.guide-copy {
  display: block;
}

.guide-label {
  color: #dfbf79;
  font-size: 21rpx;
  font-weight: 700;
}

.guide-copy {
  margin-top: 7rpx;
  color: #9ba4b0;
  font-size: 22rpx;
  line-height: 1.55;
}

.tip-row .guide-label {
  color: #b5bdc9;
}

.knowledge-panel {
  width: 100%;
  margin-top: 30rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(215, 180, 106, 0.18);
  border-radius: 22rpx;
  background: rgba(7, 10, 15, 0.5);
  position: relative;
  text-align: left;
  z-index: 1;
}

.knowledge-title {
  color: #e3c27e;
  font-size: 27rpx;
  font-weight: 700;
}

.knowledge-description,
.no-intel {
  margin-top: 10rpx;
  color: #858e9c;
  font-size: 23rpx;
  line-height: 1.55;
}

.knowledge-players {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.knowledge-player {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(97, 112, 132, 0.26);
  background: linear-gradient(180deg, #28313f, #202735);
  color: #eef0f2;
  font-size: 24rpx;
}

.knowledge-seat {
  color: #d5b269;
  font-size: 21rpx;
}

.identity-actions {
  margin-top: auto;
  padding-top: 30rpx;
}

.confirm-button {
  width: 100%;
}

.privacy-copy {
  margin: 24rpx 28rpx 0;
  color: #737c88;
  font-size: 21rpx;
  line-height: 1.55;
  text-align: center;
}

.retry-button {
  margin-top: 24rpx;
}

@media (max-width: 350px) {
  .identity-page {
    padding-top: 30rpx;
  }

  .identity-title {
    font-size: 41rpx;
  }

  .secret-card {
    min-height: 680rpx;
    margin-top: 30rpx;
    padding: 42rpx 28rpx;
  }

  .seal {
    width: 154rpx;
    height: 154rpx;
    font-size: 76rpx;
  }

  .small-seal {
    width: 104rpx;
    height: 104rpx;
    font-size: 50rpx;
  }

  .role-name {
    font-size: 64rpx;
  }

  .role-guide {
    padding-right: 20rpx;
    padding-left: 20rpx;
  }

  .knowledge-panel {
    padding: 22rpx;
  }
}

@media (max-height: 700px) {
  .identity-page {
    padding-top: 24rpx;
  }

  .identity-warning {
    margin-top: 12rpx;
  }

  .secret-card {
    min-height: 620rpx;
    margin-top: 24rpx;
  }

  .identity-actions {
    padding-top: 24rpx;
  }
}
