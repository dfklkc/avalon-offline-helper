<view class="page-shell room-page">
  <view class="room-topbar">
    <view class="room-code-block" bindtap="copyRoomCode">
      <text class="room-code-label">房间码</text>
      <text class="room-code">{{roomCode}}</text>
      <text class="copy-label">复制</text>
    </view>
    <view class="topbar-actions">
      <button class="mini-button" bindtap="openRules">规则</button>
      <button wx:if="{{canViewIdentity}}" class="mini-button identity-button" bindtap="openIdentity">身份</button>
    </view>
  </view>

  <view class="sync-row {{offline ? 'is-offline' : ''}}">
    <view class="sync-dot"></view>
    <text>{{connectionText}}</text>
    <text wx:if="{{lastUpdated && !offline}}" class="sync-time">{{lastUpdated}}</text>
    <text wx:if="{{offline}}" class="retry-link" bindtap="retryNow">立即重试</text>
  </view>

  <view wx:if="{{error}}" class="error-banner">{{error}}</view>
  <button wx:if="{{roomUnavailable}}" class="secondary-button unavailable-button" bindtap="clearRoomAndReturn">清除记录并返回首页</button>

  <view wx:if="{{loading}}" class="loading-room card">
    <view class="loading-orbit">◇</view>
    <view class="loading-room-title">正在连接圆桌</view>
    <view class="muted">取回玩家与当前流程…</view>
  </view>

  <block wx:if="{{room && me}}">
    <view class="phase-card card">
      <view class="phase-copy">
        <text class="phase-kicker">{{isLobby ? '大厅' : (isFinished ? '结算' : '第 ' + questNumber + ' 轮')}}</text>
        <view class="phase-title">{{phaseLabel}}</view>
        <view class="phase-hint">{{phaseHint}}</view>
      </view>
      <view wx:if="{{!isLobby && !isRoleReveal && !isFinished}}" class="score-box">
        <view class="score-row score-good"><text>成功</text><text class="strong">{{room.goodWins || 0}}</text></view>
        <view class="score-row score-evil"><text>失败</text><text class="strong">{{room.evilWins || 0}}</text></view>
      </view>
    </view>

    <view wx:if="{{!isLobby && !isRoleReveal}}" class="quest-track card">
      <view wx:for="{{questTrack}}" wx:key="index" class="quest-node {{item.state}}">
        <view class="quest-circle">{{item.state === 'success' ? '✓' : (item.state === 'fail' ? '×' : item.label)}}</view>
        <text>{{item.state === 'current' ? '当前' : '第' + item.label + '轮'}}</text>
      </view>
    </view>

    <view class="players-section card">
      <view class="section-head">
        <view>
          <view class="section-title">圆桌成员</view>
          <view class="section-subtitle">{{players.length}} / {{room.desiredPlayers}} 人 · 点击玩家记录私密备注</view>
        </view>
        <view wx:if="{{!isLobby}}" class="leader-summary">领队 · {{leaderName}}</view>
      </view>

      <view class="player-list">
        <view
          wx:for="{{players}}"
          wx:key="id"
          class="player-row {{item.selected ? 'is-selected' : ''}} {{item.onCurrentTeam ? 'is-on-team' : ''}}"
          data-id="{{item.id}}"
          bindtap="openPlayerNote"
        >
          <view class="player-seat">{{item.seatLabel}}</view>
          <view class="player-avatar">{{item.initial}}</view>
          <view class="player-main">
            <view class="player-name-row">
              <text class="player-name">{{item.nickname}}</text>
              <text wx:if="{{item.isMe}}" class="tiny-tag me-tag">我</text>
              <text wx:if="{{item.isHost}}" class="tiny-tag host-tag">房主</text>
              <text wx:if="{{item.isLeader && !isLobby}}" class="tiny-tag leader-tag">领队</text>
            </view>
            <view wx:if="{{isLobby}}" class="ready-state {{item.ready ? 'ready' : ''}}">{{item.ready ? '已准备' : '未准备'}}</view>
            <view wx:elif="{{!item.isMe}}" class="private-note-state mark-{{item.noteMark}}">
              <text>{{item.noteSymbol}} {{item.noteMarkLabel}}</text>
              <text wx:if="{{item.hasNote}}" class="has-note">有备注</text>
            </view>
          </view>
          <button
            wx:if="{{canSelectTeam}}"
            class="select-player-button {{item.selected ? 'selected' : ''}}"
            data-id="{{item.id}}"
            catchtap="toggleTeamPlayer"
          >{{item.selected ? '已选' : '入队'}}</button>
          <button
            wx:elif="{{isAssassination && isAssassin && !item.isMe}}"
            class="target-player-button {{assassinationTargetId === item.id ? 'selected' : ''}}"
            data-id="{{item.id}}"
            catchtap="selectAssassinationTarget"
          >{{assassinationTargetId === item.id ? '已锁定' : '选择'}}</button>
          <view wx:elif="{{item.onCurrentTeam}}" class="mission-badge">任务队</view>
          <view wx:elif="{{!item.isMe}}" class="note-chevron">›</view>
        </view>
      </view>
    </view>

    <view wx:if="{{isLobby}}" class="action-card card">
      <view class="action-title">开局准备</view>
      <view class="lobby-meta">
        <text>{{room.mode === 'beginner' ? '入门模式' : '经典模式'}}</text>
        <text>{{room.desiredPlayers}} 人局</text>
      </view>
      <view wx:if="{{roleChips.length}}" class="role-chips">
        <text wx:for="{{roleChips}}" wx:key="id" class="role-chip">{{item.label}}</text>
      </view>
      <button class="{{me.ready ? 'secondary-button' : 'primary-button'}} full-button" disabled="{{actionBusy}}" bindtap="toggleReady">
        {{me.ready ? '取消准备' : '我已准备'}}
      </button>
      <button wx:if="{{me.isHost}}" class="primary-button full-button host-start" disabled="{{!canStart || actionBusy}}" bindtap="startGame">
        {{players.length < room.desiredPlayers ? '等待玩家到齐' : (canStart ? '发牌并开始' : '等待全员准备')}}
      </button>
      <button class="ghost-button leave-button" disabled="{{actionBusy}}" bindtap="leaveRoom">离开房间</button>
    </view>

    <view wx:if="{{isRoleReveal}}" class="action-card card identity-action-card">
      <view class="action-symbol">◈</view>
      <view class="action-title">私下确认身份</view>
      <view class="action-copy">请不要把屏幕交给其他玩家。按住卡片查看，松手后自动遮罩。</view>
      <button class="primary-button full-button" bindtap="openIdentity">
        {{me.roleAcknowledged ? '再次查看身份' : '查看并确认身份'}}
      </button>
      <view wx:if="{{me.roleAcknowledged}}" class="waiting-copy">你已确认，正在等待其他玩家…</view>
    </view>

    <view wx:if="{{isTeamBuilding}}" class="action-card card">
      <view class="round-label">第 {{questNumber}} 轮 · 第 {{room.proposalAttempt}} 次提案</view>
      <view class="action-title">选择 {{room.teamSize}} 名任务成员</view>
      <view wx:if="{{canSelectTeam}}">
        <view class="selection-progress">已选 <text class="strong">{{selectedCount}}</text> / {{room.teamSize}}</view>
        <button class="primary-button full-button" disabled="{{selectedCount !== room.teamSize || actionBusy}}" bindtap="submitTeam">提交队伍</button>
      </view>
      <view wx:else class="waiting-panel">等待领队 {{leaderName}} 完成组队…</view>
    </view>

    <view wx:if="{{isTeamVote}}" class="action-card card">
      <view class="round-label">第 {{questNumber}} 轮 · 队伍表决</view>
      <view class="action-title">你同意这支队伍吗？</view>
      <view class="team-pills">
        <text wx:for="{{currentTeam}}" wx:key="id" class="team-pill">{{item.seatLabel}} · {{item.nickname}}</text>
      </view>
      <view wx:if="{{canTeamVote}}" class="vote-actions">
        <button class="reject-button" data-vote="reject" disabled="{{actionBusy}}" bindtap="castTeamVote">反对</button>
        <button class="approve-button" data-vote="approve" disabled="{{actionBusy}}" bindtap="castTeamVote">赞成</button>
      </view>
      <view wx:else class="waiting-panel">
        {{me.hasTeamVoted ? '你已投票，等待全员揭示…' : '等待表决开始…'}}
        <view wx:if="{{room.teamVoteProgress.total}}" class="vote-progress">{{room.teamVoteProgress.submitted}} / {{room.teamVoteProgress.total}} 人已提交</view>
      </view>
    </view>

    <view wx:if="{{isMissionVote}}" class="action-card card mission-action-card">
      <view class="round-label">第 {{questNumber}} 轮 · 秘密任务票</view>
      <view class="action-title">执行圆桌任务</view>
      <view class="threshold-note">本轮需要 {{room.failThreshold}} 张失败票才会失败</view>
      <view class="team-pills">
        <text wx:for="{{currentTeam}}" wx:key="id" class="team-pill">{{item.seatLabel}} · {{item.nickname}}</text>
      </view>
      <view wx:if="{{canMissionVote}}" class="mission-actions">
        <button class="success-button" data-vote="success" disabled="{{actionBusy}}" bindtap="castMissionVote">成功</button>
        <button wx:if="{{canMissionFail}}" class="fail-button" data-vote="fail" disabled="{{actionBusy}}" bindtap="castMissionVote">失败</button>
      </view>
      <view wx:elif="{{me.hasMissionVoted}}" class="waiting-panel">
        你已提交，等待其他任务成员…
        <view wx:if="{{room.missionVoteProgress.total}}" class="vote-progress">{{room.missionVoteProgress.submitted}} / {{room.missionVoteProgress.total}} 人已提交</view>
      </view>
      <view wx:else class="waiting-panel">你不在本轮队伍中，请等待任务结果。</view>
      <view class="privacy-strip">任务票永不显示个人归属</view>
    </view>

    <view wx:if="{{isAssassination}}" class="action-card card assassination-card">
      <view class="action-symbol evil-symbol">†</view>
      <view class="action-title">找出真正的梅林</view>
      <view wx:if="{{isAssassin}}">
        <view class="action-copy">与邪恶同伴讨论，然后在上方玩家列表选择一人。候选列表不会替你筛选阵营。</view>
        <button class="danger-button full-button" disabled="{{!assassinationTargetId || actionBusy}}" bindtap="submitAssassination">确认刺杀目标</button>
      </view>
      <view wx:else class="waiting-panel">邪恶方正在讨论，等待刺客提交目标…</view>
    </view>

    <view wx:if="{{isFinished}}" class="result-card card {{winnerClass}}">
      <view class="result-crown">◇</view>
      <view class="result-title">{{winnerLabel}}</view>
      <view wx:if="{{finishReasonLabel}}" class="result-reason">{{finishReasonLabel}}</view>
      <view class="revealed-roles">
        <view wx:for="{{revealedRoles}}" wx:key="id" class="revealed-role">
          <view>
            <text class="revealed-seat">{{item.seatLabel}}</text>
            <text class="revealed-name">{{item.playerName}}</text>
          </view>
          <text class="revealed-role-name camp-{{item.camp}}">{{item.roleLabel}}</text>
        </view>
      </view>
      <button wx:if="{{me.isHost}}" class="primary-button full-button rematch-button" disabled="{{actionBusy}}" bindtap="rematch">再来一局</button>
    </view>

    <view wx:if="{{hasHistory}}" class="history-section">
      <view class="history-heading">
        <view class="section-title">票型统计</view>
        <view class="section-subtitle">组队票公开到个人；任务票仅显示总数</view>
      </view>

      <view wx:if="{{missionStats.length}}" class="history-card card">
        <view class="history-card-title">任务结果</view>
        <view wx:for="{{missionStats}}" wx:key="id" class="mission-history-row">
          <view class="history-result-icon {{item.succeeded ? 'success' : 'fail'}}">{{item.questNumber}}</view>
          <view class="history-main">
            <view class="history-row-title">第 {{item.questNumber}} 轮 · {{item.resultLabel}}</view>
            <view class="history-team">{{item.teamNames}}</view>
          </view>
          <view class="mission-counts">
            <text class="success-count">成功 {{item.successVotes}}</text>
            <text class="fail-count">失败 {{item.failVotes}}</text>
          </view>
        </view>
        <view class="no-inference-note">不将失败票推断或归因到任何个人</view>
      </view>

      <view wx:if="{{proposalStats.length}}" class="history-card card">
        <view class="history-card-title">组队表决</view>
        <view wx:for="{{proposalStats}}" wx:key="id" class="proposal-history">
          <view class="proposal-head">
            <view>
              <view class="history-row-title">第 {{item.questNumber}} 轮 · 第 {{item.attempt}} 次</view>
              <view class="history-team">领队 {{item.leaderName}} · {{item.teamNames}}</view>
            </view>
            <text class="proposal-result {{item.approved ? 'approved' : 'rejected'}}">{{item.resultLabel}}</text>
          </view>
          <view class="vote-grid">
            <view wx:for="{{item.votes}}" wx:key="playerId" wx:for-item="vote" class="vote-chip {{vote.vote}}">
              <text>{{vote.seatLabel}} · {{vote.nickname}}</text>
              <text class="strong">{{vote.voteLabel}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{noteOpen}}" class="note-overlay" catchtouchmove="noop" bindtap="closeNote">
    <view class="note-sheet" catchtap="noop">
      <view class="note-handle"></view>
      <view class="note-sheet-head">
        <view>
          <view class="note-private-label">仅你可见</view>
          <view class="note-target-name">{{noteTargetName}}</view>
        </view>
        <text class="note-close" bindtap="closeNote">×</text>
      </view>
      <view class="note-label">判断标记</view>
      <view class="mark-grid">
        <view wx:for="{{markOptions}}" wx:key="value" class="mark-option mark-{{item.value}} {{noteMark === item.value ? 'selected' : ''}}" data-mark="{{item.value}}" bindtap="selectNoteMark">
          <text class="mark-symbol">{{item.symbol}}</text>
          <text>{{item.label}}</text>
        </view>
      </view>
      <view class="note-label note-text-label">文字备注 <text>{{noteLength}} / 80</text></view>
      <textarea
        class="note-textarea"
        maxlength="80"
        auto-height="{{false}}"
        placeholder="记录发言、组队和票型线索…"
        placeholder-class="note-placeholder"
        value="{{noteText}}"
        bindinput="onNoteInput"
      ></textarea>
      <button class="primary-button full-button" loading="{{savingNote}}" disabled="{{savingNote}}" bindtap="saveNote">保存私密备注</button>
      <view class="safe-bottom"></view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
