.landing-page {
  padding-top: 58rpx;
}

.hero {
  margin-bottom: 42rpx;
  text-align: center;
}

.hero-mark {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.hero-mark-ring {
  display: flex;
  width: 84rpx;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(219, 184, 111, 0.48);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(199, 154, 75, 0.16), rgba(18, 23, 32, 0.2));
  box-shadow: 0 0 0 9rpx rgba(206, 163, 82, 0.035), 0 16rpx 36rpx rgba(0, 0, 0, 0.25);
  color: #dfbd77;
  font-size: 48rpx;
}

.hero-subtitle {
  margin-top: 16rpx;
  color: #9da4af;
  font-size: 27rpx;
  letter-spacing: 1rpx;
}

.hero-divider {
  display: flex;
  align-items: center;
  gap: 14rpx;
  max-width: 430rpx;
  margin: 28rpx auto 0;
  color: #5e6672;
  font-size: 16rpx;
  letter-spacing: 3rpx;
}

.hero-divider view {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #3c4350);
}

.hero-divider view:last-child {
  background: linear-gradient(90deg, #3c4350, transparent);
}

.return-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 24rpx 26rpx;
  border-color: rgba(222, 182, 103, 0.34);
  background: linear-gradient(120deg, rgba(126, 89, 37, 0.38), rgba(27, 34, 47, 0.98) 68%);
}

.return-card-hover {
  border-color: rgba(232, 196, 125, 0.58);
  opacity: 0.9;
}

.return-kicker {
  color: #aba28f;
  font-size: 22rpx;
}

.return-code {
  margin-top: 4rpx;
  color: #f0ce87;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 7rpx;
}

.return-action {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #f0dcc0;
  font-size: 25rpx;
  font-weight: 600;
}

.return-arrow {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(221, 185, 112, 0.34);
  border-radius: 50%;
  background: rgba(9, 12, 18, 0.24);
  color: #edca82;
  font-size: 25rpx;
}

.setup-card {
  padding: 32rpx 30rpx 38rpx;
}

.field-block {
  margin-top: 20rpx;
}

.input-placeholder {
  color: #626b79;
}

.section-divider {
  height: 1rpx;
  margin: 34rpx 0;
  background: #313846;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.compact-heading {
  margin-bottom: 0;
}

.section-index {
  margin-right: 14rpx;
  color: #8f7648;
  font-family: Georgia, serif;
  font-size: 20rpx;
}

.inline-title {
  display: inline;
}

.section-caption {
  color: #777f8c;
  font-size: 22rpx;
}

.dual-fields {
  display: flex;
  gap: 18rpx;
}

.compact-field {
  flex: 1;
  min-width: 0;
}

.picker-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 27rpx;
}

.picker-arrow {
  color: #8b93a0;
}

.mode-hint {
  margin-top: 14rpx;
  padding-left: 4rpx;
  color: #7f8794;
  font-size: 23rpx;
}

.create-button {
  margin-top: 32rpx;
}

.or-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 32rpx 0 28rpx;
  color: #69717f;
  font-size: 22rpx;
}

.or-line {
  flex: 1;
  height: 1rpx;
  background: #303744;
}

.join-row {
  display: flex;
  gap: 16rpx;
}

.code-input {
  flex: 1;
  min-width: 0;
  font-weight: 700;
  letter-spacing: 6rpx;
}

.join-button {
  width: 176rpx;
}

.privacy-note {
  margin: 28rpx 8rpx 0;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(107, 118, 134, 0.18);
  border-radius: 16rpx;
  background: rgba(18, 23, 32, 0.52);
  color: #7f8793;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.privacy-icon {
  margin-right: 8rpx;
  color: #a98a50;
}

.rules-link {
  min-height: 64rpx;
  margin: 18rpx auto 0;
  padding: 0 22rpx;
  background: transparent;
  color: #b89a61;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 64rpx;
}

@media (max-width: 350px) {
  .landing-page {
    padding-top: 42rpx;
  }

  .hero {
    margin-bottom: 34rpx;
  }

  .dual-fields {
    flex-direction: column;
  }

  .section-heading {
    align-items: flex-start;
    gap: 8rpx;
  }

  .section-caption {
    max-width: 190rpx;
    text-align: right;
  }

  .join-button {
    width: 156rpx;
  }
}
