.rules-page {
  padding-top: 46rpx;
}

.rules-title {
  font-size: 50rpx;
}

.rules-lead {
  margin-top: 22rpx;
  max-width: 650rpx;
  color: #a5adb8;
  font-size: 27rpx;
  line-height: 1.7;
}

.camp-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 32rpx;
}

.camp-card {
  flex: 1;
  min-height: 226rpx;
  padding: 24rpx;
  border: 1rpx solid;
  border-radius: 24rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.035), 0 14rpx 34rpx rgba(0, 0, 0, 0.15);
}

.good-card {
  border-color: rgba(97, 156, 199, 0.45);
  background: linear-gradient(145deg, rgba(48, 105, 143, 0.28), rgba(24, 35, 48, 0.54));
}

.evil-card {
  border-color: rgba(190, 74, 70, 0.45);
  background: linear-gradient(145deg, rgba(127, 40, 43, 0.28), rgba(45, 26, 34, 0.5));
}

.camp-card-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.camp-icon {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid currentColor;
  border-radius: 50%;
  color: #83bddc;
  font-size: 25rpx;
}

.evil-card .camp-icon {
  color: #de817b;
}

.camp-kicker {
  color: #abb6c4;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.camp-goal {
  margin-top: 20rpx;
  color: #fff4df;
  font-size: 31rpx;
  font-weight: 700;
}

.camp-detail {
  margin-top: 12rpx;
  color: #9ca3ae;
  font-size: 22rpx;
  line-height: 1.5;
}

.team-table {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
}

.table-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(67, 78, 94, 0.64);
}

.table-title {
  color: #eee3d1;
  font-size: 27rpx;
  font-weight: 700;
}

.table-caption {
  color: #737d8a;
  font-size: 19rpx;
  letter-spacing: 2rpx;
}

.team-table-head,
.team-table-row,
.round-sizes {
  display: flex;
  align-items: center;
}

.team-table-head,
.team-table-row {
  min-height: 62rpx;
  border-bottom: 1rpx solid rgba(62, 72, 87, 0.62);
}

.team-table-head {
  color: #737c89;
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.team-table-row:last-of-type {
  border-bottom: 0;
}

.player-count,
.team-table-head > view:first-child {
  width: 130rpx;
  flex: 0 0 130rpx;
}

.player-count {
  color: #d9c7aa;
  font-size: 23rpx;
  font-weight: 600;
}

.round-sizes {
  flex: 1;
  justify-content: space-between;
}

.round-sizes > text {
  display: inline-flex;
  width: 48rpx;
  height: 42rpx;
  align-items: center;
  justify-content: center;
  color: #a6aeba;
  font-size: 22rpx;
  text-align: center;
}

.round-sizes .double-fail {
  border: 1rpx solid rgba(197, 81, 76, 0.18);
  border-radius: 10rpx;
  background: rgba(174, 74, 69, 0.2);
  color: #e19a93;
}

.star {
  color: #e27d76;
  font-size: 16rpx;
}

.table-note {
  margin-top: 14rpx;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(102, 42, 44, 0.14);
  color: #7f8895;
  font-size: 20rpx;
  line-height: 1.5;
}

.rule-list {
  margin-top: 28rpx;
  padding: 0 28rpx 8rpx;
}

.rule-list-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 24rpx 0 20rpx;
  border-bottom: 1rpx solid rgba(65, 75, 90, 0.7);
  color: #eee3d1;
  font-size: 27rpx;
  font-weight: 700;
}

.rule-list-header text:last-child {
  color: #746d61;
  font-size: 17rpx;
  letter-spacing: 3rpx;
}

.rule-item {
  display: flex;
  gap: 22rpx;
  padding: 30rpx 0;
  border-bottom: 1rpx solid rgba(62, 72, 87, 0.62);
}

.rule-item:last-child {
  border-bottom: 0;
}

.rule-number {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(215, 180, 106, 0.5);
  border-radius: 50%;
  background: rgba(162, 125, 58, 0.08);
  color: #d8b56b;
  font-family: Georgia, serif;
  font-size: 27rpx;
}

.rule-copy {
  flex: 1;
}

.rule-title {
  color: #f6ead6;
  font-size: 28rpx;
  font-weight: 700;
}

.rule-detail {
  margin-top: 10rpx;
  color: #929aa6;
  font-size: 24rpx;
  line-height: 1.65;
}

.rules-footnote {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin: 26rpx 4rpx 0;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(168, 137, 77, 0.18);
  border-left: 4rpx solid #a8894d;
  border-radius: 0 16rpx 16rpx 0;
  background: rgba(24, 29, 39, 0.46);
  color: #8c95a1;
  font-size: 22rpx;
  line-height: 1.6;
}

.footnote-icon {
  flex: 0 0 auto;
  color: #b09155;
  font-size: 28rpx;
}

@media (max-width: 350px) {
  .rules-page {
    padding-top: 34rpx;
  }

  .rules-title {
    font-size: 44rpx;
  }

  .rules-lead {
    font-size: 24rpx;
  }

  .camp-grid {
    flex-direction: column;
  }

  .camp-card {
    min-height: 0;
  }

  .camp-goal {
    font-size: 28rpx;
  }

  .team-table,
  .rule-list {
    padding-right: 20rpx;
    padding-left: 20rpx;
  }

  .player-count,
  .team-table-head > view:first-child {
    width: 112rpx;
    flex-basis: 112rpx;
  }

  .rule-item {
    gap: 16rpx;
  }

  .rule-detail {
    font-size: 22rpx;
  }
}
