page {
  min-height: 100%;
  background: #090c12;
  color: #f4ead7;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
picker {
  box-sizing: border-box;
}

button {
  margin: 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  transition: opacity 120ms ease, transform 120ms ease, background-color 120ms ease;
}

button::after {
  border: 0;
}

.button-hover {
  opacity: 0.86;
  transform: scale(0.985);
}

.page-shell {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  background:
    radial-gradient(circle at 88% -2%, rgba(204, 158, 76, 0.17), transparent 30%),
    radial-gradient(circle at -12% 42%, rgba(52, 93, 127, 0.1), transparent 28%),
    linear-gradient(180deg, #121722 0%, #0b0f16 48%, #080a0f 100%);
}

.eyebrow {
  color: #d1ae68;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 7rpx;
  line-height: 1.4;
  text-transform: uppercase;
}

.display-title {
  margin-top: 14rpx;
  color: #fff8e9;
  font-family: Georgia, "Songti SC", serif;
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: 3rpx;
  text-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.28);
}

.muted {
  color: #979eaa;
}

.gold {
  color: #d7b46a;
}

.card {
  border: 1rpx solid rgba(216, 184, 119, 0.2);
  border-radius: 26rpx;
  background: linear-gradient(155deg, rgba(28, 35, 48, 0.97), rgba(20, 25, 35, 0.97));
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.24), inset 0 1rpx 0 rgba(255, 255, 255, 0.025);
}

.section-title {
  color: #f4ead7;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: #b8bec8;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.field-control {
  width: 100%;
  min-height: 92rpx;
  padding: 0 26rpx;
  border: 1rpx solid #3a4352;
  border-radius: 18rpx;
  background: rgba(13, 18, 27, 0.88);
  color: #fff8e9;
  line-height: 92rpx;
}

.primary-button {
  min-height: 92rpx;
  padding: 0 28rpx;
  border: 1rpx solid rgba(255, 232, 179, 0.38);
  background: linear-gradient(135deg, #e7cb8d 0%, #c19243 100%);
  box-shadow: 0 12rpx 28rpx rgba(155, 111, 42, 0.2), inset 0 1rpx 0 rgba(255, 255, 255, 0.32);
  color: #17120b;
  line-height: 92rpx;
}

.secondary-button {
  min-height: 88rpx;
  padding: 0 26rpx;
  border: 1rpx solid #4a5568;
  background: linear-gradient(180deg, #202735, #171d28);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.035);
  color: #f1e6d3;
  line-height: 88rpx;
}

.danger-button {
  min-height: 88rpx;
  border: 1rpx solid rgba(206, 86, 82, 0.6);
  background: linear-gradient(180deg, rgba(131, 46, 48, 0.42), rgba(93, 31, 35, 0.38));
  color: #ffb2ad;
  line-height: 88rpx;
}

.ghost-button {
  min-height: 76rpx;
  padding: 0 24rpx;
  border: 1rpx solid #394150;
  background: transparent;
  color: #c7cbd2;
  font-size: 26rpx;
  line-height: 76rpx;
}

button[disabled] {
  box-shadow: none;
  opacity: 0.38;
}

.error-banner {
  margin-bottom: 22rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(224, 98, 92, 0.36);
  border-left: 5rpx solid #d86c66;
  border-radius: 18rpx;
  background: linear-gradient(90deg, rgba(128, 40, 40, 0.28), rgba(70, 31, 36, 0.17));
  color: #ffc0bb;
  font-size: 25rpx;
  line-height: 1.5;
}

.empty-state {
  padding: 46rpx 24rpx;
  color: #858d9a;
  text-align: center;
}

.safe-bottom {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}

@media (max-width: 350px) {
  .page-shell {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .display-title {
    font-size: 54rpx;
  }

  .card {
    border-radius: 22rpx;
  }

  .primary-button,
  .secondary-button {
    min-height: 86rpx;
    line-height: 86rpx;
  }
}
